# ============================================================================
# Trinity 环境变量示例
# 用法：复制为 .env 后填入真实值 —— cp .env.example .env
# 注意：.env 已在 .gitignore 中，切勿提交真实密钥
# ============================================================================

# ------------------------------- LLM ---------------------------------------
# deepseek | openai | custom
LLM_PROVIDER=deepseek

# DeepSeek 控制台申请：https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI 兼容 Base URL
#   DeepSeek 官方          https://api.deepseek.com/v1
#   第三方中转 / 自建网关   按供应商文档填写
LLM_BASE_URL=https://api.deepseek.com/v1

# 大模型：planner / reviewer / judge 使用
#   端点实际可用的 id（`GET /v1/models` 实测）：deepseek-flash / deepseek-v4-pro
LLM_MODEL_LARGE=deepseek-flash

# 小模型：executor 的工具选择等轻量决策使用
LLM_MODEL_SMALL=deepseek-flash

LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# 模型不支持 response_format=json_object 时改为 false
LLM_JSON_MODE=true

# 成本估算兜底单价（元 / 100 万 token），按所用模型官网价调整
#   ⚠️ 「兜底」二字是生效条件：只有**不在 `core/llm/adapter.py` 的 `MODEL_PRICES` 表里**的模型
#   才用这两行。`deepseek-flash` / `deepseek-v4-pro` 都在表内 ⇒ 改这里不会改变它们的价，
#   要改价得改那张表（表里的键还支持前缀匹配，如 `deepseek-v4-pro-0813`）。
#   ⚠️ 单位必须是「元 / 100 万 token」，与 `MODEL_PRICES` 和消费方的公式
#   `token / 1_000_000 × 单价` 一致。这里填成每 token 的价（如 `2.13e-6`）不会报错，
#   只会把成本悄悄低估 10⁶ 倍 —— 2026-09-24 就在 `config.py` 的默认值上踩过一次。
LLM_PRICE_IN=2.0
LLM_PRICE_OUT=8.0

# ----------------------------- Workflow ------------------------------------
MAX_ITERATIONS=5
REVIEW_THRESHOLD=7
ENABLE_HITL=false

# ------------------------------- Tools ------------------------------------
TOOL_TIMEOUT=30
TOOL_RETRY=2

# ------------------------------ Storage -----------------------------------
WORKSPACE_DIR=data/workspace
DB_URL=sqlite:///./data/trinity.db
REDIS_URL=redis://localhost:6379/0

# ------------------------------- Misc -------------------------------------
LOG_LEVEL=INFO

# --------------------------- 知识库 / RAG (M2) ------------------------------
# 知识库根目录（上传原件存 files/ 子目录）
KNOWLEDGE_DIR=data/knowledge

# embedding 提供商：M2 仅支持 local
EMBEDDING_PROVIDER=local

# bge 权重目录（绝对路径）。留空则由 scripts/probe_bge_weights.py 探测；
# 探测结果由脚本/人工回填到 .env，运行时不做磁盘扫描
EMBEDDING_MODEL_PATH=
EMBEDDING_MODEL_NAME=bge-small-zh-v1.5
EMBEDDING_DIM=512
EMBEDDING_BATCH_SIZE=32

# 切分参数（token 口径，chunk_size 上限 480：为模型 max_seq 512 留余量）
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# 检索融合权重（两者之和应 ≈1，偏差会被归一化并告警）。
# 2026-10-03 与 config.py 一起改成纯 BM25：五组同索引对照里它在 top-1/top-3/MRR 三项最优
# （91.43% / 95.71% / 0.9362），旧默认 0.4:0.6 四项全输；依据见 docs/m3_ablation_report.md 与 config.py 字段注释。
# ⚠️ 这一档**不省延迟**：向量路无条件执行（rag/retriever.py:141），权重给 0 也照样嵌查询向量。
# ⚠️ 这里写了值，就会**盖掉 config.py 的默认值** —— 已有的 .env 要同步改这两行才真的生效。
BM25_WEIGHT=1.0
VECTOR_WEIGHT=0.0

KNOWLEDGE_TOP_K=5
KNOWLEDGE_MAX_FILE_MB=50

# 向量库后端：spike 结论固化（sqlite-vec | chroma）
VECTOR_STORE_BACKEND=sqlite-vec

# 索引队列容量（满 → 429）
KNOWLEDGE_QUEUE_MAX_SIZE=20

# fastembed ONNX 权重持久缓存目录（相对路径相对项目根）
FASTEMBED_CACHE_DIR=data/models/fastembed_cache

# bge 权重若需下载（本机 HF 直连不可用，走镜像）：
#   PowerShell: $env:HF_ENDPOINT="https://hf-mirror.com"; hf download BAAI/bge-small-zh-v1.5 --local-dir data/models/bge-small-zh-v1.5
# HF_ENDPOINT=https://hf-mirror.com
